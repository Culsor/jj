# Telegram API credentials — get from https://my.telegram.org
API_ID=
API_HASH=

# Bot token from @BotFather
BOT_TOKEN=

# MongoDB connection string (MongoDB Atlas or self-hosted)
MONGO_URI=
MONGO_DB_NAME=sticker_video_bot

# Your Telegram user ID (for /stats and /broadcast access)
OWNER_ID=

# Port the health-check web server binds to (Render/Railway inject this automatically)
PORT=8080

# Optional limits
MAX_FILE_SIZE_MB=50
FFMPEG_TIMEOUT=120
TEMP_DIR=/tmp/svbot

# Optional: require users to join a channel before using the bot, e.g. @yourchannel
FORCE_SUB_CHANNEL=
